# Copy to .env and adjust. Never commit .env.

# Local development (SQLite). Production must use Postgres — the app refuses
# to start with a file: URL when NODE_ENV=production, because a serverless
# filesystem is read-only and not shared between invocations.
DATABASE_URL="file:./dev.db"

# process-analyzer (github.com/AnuV6/process-analyzer) hardcodes port 3000,
# which is why GreenLight runs on 3001.
PROCESS_ANALYZER_URL="http://localhost:3000"

# Optional. Without it the security sources still work and compliance evidence
# is recorded as "not found" rather than assumed.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Raises the NIST NVD rate limit from 5 to 50 requests per 30s.
# NVD_API_KEY=
