# Copy to .env and adjust. Never commit .env.

# Postgres. DATABASE_URL is the POOLED connection the app uses;
# DIRECT_DATABASE_URL is the direct one, because Prisma migrations cannot run
# through a connection pooler.
#
# With the Neon CLI:
#   neonctl connection-string --project-id <id> --pooled
#   neonctl connection-string --project-id <id>
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# process-analyzer (github.com/AnuV6/process-analyzer) hardcodes port 3000,
# which is why GreenLight runs on 3001.
PROCESS_ANALYZER_URL="http://localhost:3000"

# Optional. Without it the security sources still work and compliance evidence
# is recorded as "not found" rather than assumed.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Raises the NIST NVD rate limit from 5 to 50 requests per 30s.
# NVD_API_KEY=

# Signs the session cookie. Required.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
