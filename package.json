{
  "name": "greenlight",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma migrate dev",
    "setup": "prisma generate && prisma migrate deploy && npm run seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build",
    "db:migrate": "prisma migrate deploy",
    "check:ai": "tsx scripts/check-credential.ts",
    "mcp": "tsx mcp/server.ts",
    "walkthrough": "tsx scripts/walkthrough.ts",
    "brand": "tsx scripts/build-brand-assets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.0.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
