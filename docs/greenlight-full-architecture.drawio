<mxfile host="app.diagrams.net" agent="GreenLight" type="device">
  <diagram name="Full architecture" id="full">
    <mxGraphModel dx="1900" dy="1250" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="GreenLight — full architecture" style="text;html=1;align=left;fontSize=23;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="45" y="24" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st" value="Four ways to drive it, three ways to reach Claude, one engine. Every route produces the same typed fact, so nothing downstream can tell them apart — and nothing downstream needs to." style="text;html=1;align=left;fontSize=12.5;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="45" y="54" width="1300" height="18" as="geometry" />
        </mxCell>

        <!-- ══════ ways in ══════ -->
        <mxCell id="lbl1" value="WAYS IN" style="text;html=1;align=right;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#656c7a;letterSpacing=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="45" y="116" width="115" height="30" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="&lt;b&gt;A person, in a browser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;the queue, a request, a decision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e5eb;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="190.0" y="114" width="215" height="56" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="&lt;b&gt;Claude, over MCP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;Claude Code · Claude Desktop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2e7;strokeColor=#b54708;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="428.0" y="114" width="215" height="56" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="&lt;b&gt;Claude, with the skill&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;a person carries the answer back&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2e7;strokeColor=#b54708;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="666.0" y="114" width="215" height="56" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="&lt;b&gt;A terminal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;npm run walkthrough&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e5eb;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="904.0" y="114" width="186" height="56" as="geometry" />
        </mxCell>

        <!-- ══════ surfaces ══════ -->
        <mxCell id="lbl2" value="WHAT THEY&lt;br&gt;TALK TO" style="text;html=1;align=right;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#656c7a;letterSpacing=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="45" y="234" width="115" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Next.js app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;9 pages · 7 API routes&lt;br&gt;sign-in, roles, audit view&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9edf7;strokeColor=#14377d;strokeWidth=2;fontSize=12;fontColor=#0f2a61;" vertex="1" parent="1">
          <mxGeometry x="190.0" y="232" width="215" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;MCP server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4 tools — &lt;b&gt;none approves&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2e7;strokeColor=#b54708;strokeWidth=2;fontSize=12;fontColor=#7a3005;" vertex="1" parent="1">
          <mxGeometry x="428.0" y="232" width="215" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Paste-back form&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /api/findings&lt;br&gt;validated, never trusted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2e7;strokeColor=#b54708;strokeWidth=2;fontSize=12;fontColor=#7a3005;" vertex="1" parent="1">
          <mxGeometry x="666.0" y="232" width="215" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Script&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;same functions,&lt;br&gt;no browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e5eb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="904.0" y="232" width="186" height="70" as="geometry" />
        </mxCell>

        <!-- ══════ engine ══════ -->
        <mxCell id="engbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fb;strokeColor=#c9cfdb;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="190.0" y="378" width="900" height="400" as="geometry" />
        </mxCell>
        <mxCell id="englbl" value="lib/ — every surface above calls these, and nothing else" style="text;html=1;align=left;fontSize=10;fontStyle=1;fontColor=#656c7a;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="205.0" y="388" width="620" height="14" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="&lt;b&gt;catalog.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;the gate. do we own it,&lt;br&gt;does it still hold,&lt;br&gt;is a seat free&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ea;strokeColor=#1e7a32;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="207.0" y="410" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;research.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;runs every source at once.&lt;br&gt;one failing costs its own&lt;br&gt;evidence, not the run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e5eb;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="425.0" y="410" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;findings.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;validates what Claude returns&lt;br&gt;and types it. a pasted blob&lt;br&gt;is untrusted input&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2e7;strokeColor=#b54708;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="643.0" y="410" width="200" height="74" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;auth · roles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;requester &amp;lt; approver &amp;lt; admin&lt;br&gt;only an approver decides&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111827;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="861.0" y="410" width="212" height="74" as="geometry" />
        </mxCell>

        <mxCell id="m5" value="&lt;b&gt;rulepack.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;derives the verdict. a claimed fact cannot satisfy a&lt;br&gt;blocking rule, and a rule it cannot evaluate asks a&lt;br&gt;person rather than guessing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9edf7;strokeColor=#14377d;strokeWidth=2;fontSize=12;fontColor=#0f2a61;" vertex="1" parent="1">
          <mxGeometry x="207.0" y="500" width="418" height="78" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="&lt;b&gt;dpia.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;privacy assessment, only&lt;br&gt;when the law requires it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e5eb;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="643.0" y="500" width="200" height="78" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="&lt;b&gt;estate.ts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;approved against running.&lt;br&gt;pushes what may run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#b42318;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="861.0" y="500" width="212" height="78" as="geometry" />
        </mxCell>

        <mxCell id="m10" value="&lt;b&gt;rules/*.yaml&lt;/b&gt;&amp;nbsp; — &amp;nbsp;policy as files, not code. Software approval for BISTEC Global, ISO documents, privacy screening. Keyed by entity, so a second one is another file. &lt;b&gt;A new approval type is a new file.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9edf7;strokeColor=#14377d;dashed=1;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="207.0" y="594" width="418" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="&lt;b&gt;audit.ts&lt;/b&gt;&amp;nbsp; — &amp;nbsp;who, when, and which version of the rules. Written in the same transaction as the decision, so a decision can never stand without its evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f6;strokeColor=#c9cfdb;dashed=1;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="643.0" y="594" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="&lt;b&gt;json · env · api · ids&lt;/b&gt;&amp;nbsp; — &amp;nbsp;the parts that keep bad input from becoming an outage: a corrupt row degrades that row, a malformed request gets a 400 rather than a 500, and ids cannot collide." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f6;strokeColor=#c9cfdb;dashed=1;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="207.0" y="670" width="866" height="54" as="geometry" />
        </mxCell>

        <!-- ══════ outside ══════ -->
        <mxCell id="lbl4" value="OUTSIDE" style="text;html=1;align=left;fontSize=10;fontStyle=1;fontColor=#656c7a;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="1208.0" y="96" width="200" height="14" as="geometry" />
        </mxCell>
        <mxCell id="x1" value="&lt;b&gt;Free security sources&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;CISA · NIST · ToSDR · OSV&lt;br&gt;no key, about one second&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e5eb;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1205.0" y="114" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="&lt;b&gt;Claude&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;direct with a key, or through&lt;br&gt;Vercel AI Gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2e7;strokeColor=#b54708;strokeWidth=2;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1205.0" y="204" width="250" height="58" as="geometry" />
        </mxCell>
        <mxCell id="skillfile" value="&lt;b&gt;SKILL.md&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;what to look for, what counts&lt;br&gt;as evidence, and to return&lt;br&gt;strict JSON — nothing else.&lt;br&gt;&lt;br&gt;Ships inside the app and is&lt;br&gt;served from it at /skill.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b54708;dashed=1;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1205.0" y="294" width="250" height="104" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="&lt;b&gt;process-analyzer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;someone else&#39;s tool. nothing in it&lt;br&gt;changed — a client, both ways&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#b42318;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="1205.0" y="430" width="250" height="58" as="geometry" />
        </mxCell>

        <!-- ══════ data ══════ -->
        <mxCell id="db" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4b5563&quot;&gt;requests · dossiers · catalog&lt;br&gt;decisions · scans · people&lt;br&gt;&lt;b&gt;audit events&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#e9edf7;strokeColor=#14377d;fontSize=11.5;" vertex="1" parent="1">
          <mxGeometry x="190.0" y="826" width="290" height="104" as="geometry" />
        </mxCell>

        <!-- ══════ the point ══════ -->
        <mxCell id="pt" value="&lt;b style=&quot;font-size:14px&quot;&gt;Three ways to reach Claude. One kind of answer.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px;color:#374151&quot;&gt;Whether a fact arrives automatically, over MCP, or because a person pasted it back, it lands as the same typed value carrying where it came from — &lt;b&gt;verified, sourced, vendor claim, or not found&lt;/b&gt;. The rule book cannot tell which route produced it, and does not need to.&lt;br&gt;&lt;br&gt;That is why losing the key costs evidence rather than correctness, and why the skill is a real fallback rather than a lesser one.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2e7;strokeColor=#b54708;strokeWidth=2;fontSize=12;align=left;spacingLeft=16;verticalAlign=top;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="520.0" y="826" width="570" height="150" as="geometry" />
        </mxCell>
        <mxCell id="nodecide" value="&lt;b&gt;Nothing in here approves anything.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151&quot;&gt;Not the engine, not the MCP tools, not Claude. An approval is the act the audit trail exists to evidence, so it needs a person with the authority to make it — and when that person overrides the engine, the page stops printing the engine&#39;s reasoning under their name.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111827;strokeWidth=2;fontSize=12;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1205.0" y="540" width="420" height="130" as="geometry" />
        </mxCell>

        <!-- ══════ edges: straight drops, no crossings ══════ -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4b5563;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="w1" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b54708;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="w2" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b54708;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="w3" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4b5563;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="w4" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#14377d;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1194;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="engbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b54708;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3839;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="engbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b54708;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6483;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="engbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4b5563;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8967;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="engbox"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- engine → outside: three lanes, each turning at its own x -->
        <mxCell id="e10" value="queries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4b5563;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.13;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engbox" target="x1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120.0" y="430" /><mxPoint x="1120.0" y="143" /></Array></mxGeometry>
