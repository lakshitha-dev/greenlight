        <mxCell id="lbl3" value="THE ENGINE" style="text;html=1;align=right;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#656c7a;letterSpacing=1;verticalAlign=top;" vertex="1" parent="1">
