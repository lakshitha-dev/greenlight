        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b5563;" edge="1" parent="1" source="s4" target="engbox"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e10" value="queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4b5563;fontSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" edge="1" parent="1" source="m2" target="x1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975" y="498" /><mxPoint x="975" y="147" /></Array></mxGeometry></mxCell>
        <mxCell id="e11" value="asks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b54708;strokeWidth=2;fontSize=10;fontColor=#b54708;" edge="1" parent="1" source="m2" target="x2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="513" /><mxPoint x="960" y="227" /></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="what may run · what is running" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b42318;strokeWidth=2;fontSize=10;fontColor=#b42318;" edge="1" parent="1" source="m7" target="x3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="612" /><mxPoint x="1290" y="307" /></Array></mxGeometry></mxCell>

