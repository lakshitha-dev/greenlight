        <mxCell id="e11" value="asks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b54708;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#b54708;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="engbox" target="x2">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1145.0" y="478" /><mxPoint x="1145.0" y="233" /></Array></mxGeometry>
