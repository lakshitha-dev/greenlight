        <mxCell id="e5" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b54708;dashed=1;fontSize=10;fontColor=#b54708;" edge="1" parent="1" source="w3" target="skillfile"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5b" value="served at /skill" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b54708;dashed=1;fontSize=10;fontColor=#b54708;endArrow=none;" edge="1" parent="1" source="skillfile" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>

