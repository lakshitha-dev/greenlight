                <mxCell id="n1" value="&lt;b&gt;Most requests stop here.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color:#4b5563&quot;&gt;Three of nine, on one day&#39;s traffic.&lt;/font&gt;" style="text;html=1;align=left;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="500" y="232" width="230" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;b&gt;An approval is not forever.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color:#4b5563&quot;&gt;When its review date passes, or new attacks&lt;br&gt;appear after it was approved, the software&lt;br&gt;stops being permitted — with nobody involved.&lt;/font&gt;" style="text;html=1;align=left;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1641" y="224" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;b&gt;A vendor&#39;s word is not evidence.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color:#4b5563&quot;&gt;If only the vendor says it, it cannot satisfy&lt;br&gt;a requirement that blocks. And anything we&lt;br&gt;could not establish is reported as unknown,&lt;br&gt;never guessed.&lt;/font&gt;" style="text;html=1;align=left;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="740" y="548" width="330" height="62" as="geometry"/>
                </mxCell>
