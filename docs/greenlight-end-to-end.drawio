<mxfile host="app.diagrams.net" agent="GreenLight" type="device">
  <diagram name="End to end" id="e2e">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="How one request becomes a decision" style="text;html=1;align=left;fontSize=24;fontStyle=1;fontColor=#14191a;" vertex="1" parent="1">
          <mxGeometry x="50" y="28" width="800" height="32" as="geometry" />
        </mxCell>
        <mxCell id="st" value="Nothing here approves anything. Every path ends at a person — what changes is how much is already done when they get there." style="text;html=1;align=left;fontSize=13;fontColor=#677577;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="1100" height="20" as="geometry" />
        </mxCell>

        <!-- ══ intake ══ -->
        <mxCell id="lblIn" value="IT ARRIVES" style="text;html=1;align=left;fontSize=10;fontStyle=1;fontColor=#93a1a3;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="112" width="200" height="16" as="geometry" />
        </mxCell>
        <mxCell id="in1" value="Someone asks&#10;for software" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e6e6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="134" width="150" height="54" as="geometry" />
        </mxCell>
        <mxCell id="in2" value="An ISO document&#10;is sent for approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e6e6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="150" height="54" as="geometry" />
        </mxCell>
        <mxCell id="in3" value="A laptop scan finds&#10;something unapproved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#f2b8b4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="266" width="150" height="54" as="geometry" />
        </mxCell>

        <!-- ══ gate ══ -->
        <mxCell id="gate" value="&lt;b&gt;DO WE ALREADY&#10;OWN THIS?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;in the catalog · still valid&lt;br&gt;right entity · seat free&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e6f4ed;strokeColor=#0f7a4d;strokeWidth=2;fontSize=12;fontColor=#0f4d31;" vertex="1" parent="1">
          <mxGeometry x="255" y="140" width="185" height="145" as="geometry" />
        </mxCell>

        <mxCell id="t0" value="&lt;b&gt;Nobody approves it&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#677577&quot;&gt;access in seconds, logged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ed;strokeColor=#0f7a4d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="112" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;Only Finance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#677577&quot;&gt;safety already settled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fd;strokeColor=#175cd3;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="176" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- ══ evidence ══ -->
        <mxCell id="lblEv" value="EVIDENCE IS GATHERED" style="text;html=1;align=left;fontSize=10;fontStyle=1;fontColor=#93a1a3;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="505" y="268" width="260" height="16" as="geometry" />
        </mxCell>

        <mxCell id="src" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cbd2d2;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="500" y="290" width="215" height="148" as="geometry" />
        </mxCell>
        <mxCell id="srcL" value="machines answer these — no key, ~1s" style="text;html=1;align=center;fontSize=9.5;fontColor=#93a1a3;" vertex="1" parent="1">
          <mxGeometry x="500" y="294" width="215" height="14" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Is anyone attacking it right now?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e6e6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="512" y="314" width="191" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="How many critical flaws?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e6e6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="512" y="344" width="191" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="What is its privacy record?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e6e6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="512" y="374" width="191" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Any open-source advisories?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e2e6e6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="512" y="404" width="191" height="26" as="geometry" />
        </mxCell>

        <!-- claude -->
        <mxCell id="cl" value="&lt;b&gt;CLAUDE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the questions with no API:&lt;br&gt;a current SOC 2? a DPA?&lt;br&gt;where does our data go?&lt;br&gt;does SSO exist on this tier?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2e7;strokeColor=#b54708;strokeWidth=2;fontSize=12;fontColor=#7a3005;" vertex="1" parent="1">
          <mxGeometry x="775" y="300" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="clW" value="three ways in, one result" style="text;html=1;align=center;fontSize=9.5;fontColor=#93a1a3;" vertex="1" parent="1">
          <mxGeometry x="775" y="437" width="200" height="14" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="automatically, with a key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f0c39a;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="775" y="455" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Claude works the queue (MCP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f0c39a;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="775" y="483" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="a person runs the skill" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f0c39a;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="775" y="511" width="200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="prov" value="&lt;b&gt;every fact says where it came from&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;verified · sourced · vendor claim · not found&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f3;strokeColor=#cbd2d2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="205" width="270" height="52" as="geometry" />
        </mxCell>

        <!-- ══ decide ══ -->
        <mxCell id="lblDe" value="THE VERDICT IS DERIVED, NOT CHOSEN" style="text;html=1;align=left;fontSize=10;fontStyle=1;fontColor=#93a1a3;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="268" width="330" height="16" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;THE RULE BOOK&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a file Operations owns,&lt;br&gt;one per legal entity&lt;br&gt;&lt;br&gt;Sri Lanka and Australia&lt;br&gt;do not have the same rules&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1fd;strokeColor=#175cd3;strokeWidth=2;fontSize=12;fontColor=#0f3d8f;" vertex="1" parent="1">
          <mxGeometry x="1055" y="290" width="195" height="140" as="geometry" />
        </mxCell>
        <mxCell id="priv" value="&lt;b&gt;Privacy assessment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#677577&quot;&gt;drafted only when the law&lt;br&gt;actually requires one&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd2d2;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1055" y="460" width="195" height="62" as="geometry" />
        </mxCell>

        <mxCell id="human" value="&lt;b&gt;A PERSON DECIDES&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Approve · with conditions&lt;br&gt;More info · Reject&lt;br&gt;&lt;br&gt;only an approver can.&lt;br&gt;a requester is refused.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#14191a;strokeWidth=3;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1330" y="290" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- ══ loops ══ -->
        <mxCell id="cat" value="&lt;b&gt;What we own&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#677577&quot;&gt;every entry expires&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=11;whiteSpace=wrap;html=1;fillColor=#e6f4ed;strokeColor=#0f7a4d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1620" y="120" width="170" height="86" as="geometry" />
        </mxCell>
        <mxCell id="ep" value="&lt;b&gt;The laptops&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#677577&quot;&gt;what may run, and&lt;br&gt;what is running&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeceb;strokeColor=#b42318;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1620" y="480" width="170" height="72" as="geometry" />
        </mxCell>

        <mxCell id="audit" value="&lt;b&gt;THE AUDIT FILE&lt;/b&gt;  —  every step above, with who did it, when, and which version of the rules applied. Including the ones nobody touched." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f3f3;strokeColor=#cbd2d2;dashed=1;fontSize=11;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="500" y="620" width="1030" height="46" as="geometry" />
        </mxCell>

        <!-- ══ edges ══ -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#677577;" edge="1" parent="1" source="in1" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#677577;" edge="1" parent="1" source="in3" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2b" value="same rule book,&#10;different file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#175cd3;dashed=1;fontSize=9.5;fontColor=#175cd3;" edge="1" parent="1" source="in2" target="rules">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="225" y="560" /><mxPoint x="1152" y="560" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="e3" value="yes, seat free" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f7a4d;strokeWidth=2;fontSize=10;fontColor=#0f7a4d;" edge="1" parent="1" source="gate" target="t0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="yes, no seat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#175cd3;strokeWidth=2;fontSize=10;fontColor=#175cd3;" edge="1" parent="1" source="gate" target="t1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="&lt;b&gt;no — or the old&#10;answer expired&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b54708;strokeWidth=2;fontSize=10;fontColor=#b54708;" edge="1" parent="1" source="gate" target="src"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#677577;" edge="1" parent="1" source="src" target="cl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#f0c39a;endArrow=none;" edge="1" parent="1" source="c2" target="cl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="facts, each with a source" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#677577;fontSize=10;" edge="1" parent="1" source="cl" target="rules"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#cbd2d2;dashed=1;" edge="1" parent="1" source="rules" target="priv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="a recommendation,&#10;never a decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#677577;fontSize=10;" edge="1" parent="1" source="rules" target="human"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="l1" value="approved → we own it now" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f7a4d;strokeWidth=2;fontSize=10;fontColor=#0f7a4d;" edge="1" parent="1" source="human" target="cat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l2" value="&lt;b&gt;so the next person who asks gets it instantly&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0f7a4d;strokeWidth=2;dashed=1;fontSize=10;fontColor=#0f7a4d;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat" target="gate">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1705" y="95" /><mxPoint x="347" y="95" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="l3" value="what may run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b42318;strokeWidth=2;fontSize=10;fontColor=#b42318;" edge="1" parent="1" source="human" target="ep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l4" value="&lt;b&gt;anything unapproved comes back as a new request&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b42318;strokeWidth=2;dashed=1;fontSize=10;fontColor=#b42318;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ep" target="in3">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1705" y="720" /><mxPoint x="125" y="720" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#cbd2d2;dashed=1;endArrow=none;" edge="1" parent="1" source="t0" target="audit">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="137" /><mxPoint x="470" y="643" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#cbd2d2;dashed=1;endArrow=none;" edge="1" parent="1" source="human" target="audit"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- annotations -->
        <mxCell id="n1" value="&lt;b&gt;Most requests stop here.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color:#677577&quot;&gt;Three of nine, on one day&#39;s traffic.&lt;/font&gt;" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="232" width="250" height="34" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;An approval is not forever.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color:#677577&quot;&gt;When its review date passes, or new attacks&lt;br&gt;appear after it was approved, the software&lt;br&gt;stops being permitted — with nobody involved.&lt;/font&gt;" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1585" y="225" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;A vendor&#39;s word is not evidence.&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color:#677577&quot;&gt;If only the vendor says it, it cannot satisfy&lt;br&gt;a requirement that blocks. And anything we&lt;br&gt;could not establish is reported as unknown,&lt;br&gt;never guessed.&lt;/font&gt;" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="555" width="330" height="62" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
